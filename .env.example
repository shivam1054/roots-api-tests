# Target: "mock" (default, starts the local mock server) or "sandbox" (real Roots sandbox)
ROOTS_TARGET=mock

# Only needed for ROOTS_TARGET=sandbox
ROOTS_BASE_URL=https://api.sandbox.roots.finance
ROOTS_API_TOKEN=rts_live_xxxxxxxxxxxxxxxx
# Optional: a key from a second client, enables the cross-client isolation test
ROOTS_OTHER_CLIENT_TOKEN=

# Webhook signing secret (only for webhook receiver tests)
ROOTS_WEBHOOK_SECRET=whsec_test_secret

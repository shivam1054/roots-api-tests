{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": { "@src/*": ["src/*"] },
    "types": ["node"]
  },
  "include": ["src", "tests", "mock-server", "playwright.config.ts"]
}
